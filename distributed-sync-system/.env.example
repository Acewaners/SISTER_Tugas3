# Node Configuration
NODE_COUNT=3
NODE_HOST=0.0.0.0

# Raft Configuration
ELECTION_TIMEOUT_MIN=150
ELECTION_TIMEOUT_MAX=300
HEARTBEAT_INTERVAL=50

# Lock Configuration
LOCK_DEFAULT_TTL=30
LOCK_MAX_TTL=300

# Queue Configuration
VIRTUAL_NODES=150
MESSAGE_MAX_RETRY=3
CONSUMER_TIMEOUT=30

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_DEFAULT_TTL=300

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Security
API_KEY_ADMIN=admin-secret-key-change-this
API_KEY_PRODUCER=producer-key
API_KEY_CONSUMER=consumer-key
API_KEY_READER=reader-key
ENABLE_TLS=false

# Logging
LOG_LEVEL=INFO